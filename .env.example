# ==============================================================================
# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
# ==============================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon/Publishable API Key (safe for frontend use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase Service Role Key (SERVER ONLY, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
